#!/bin/bash
set -euo pipefail

# Default values
TARGET_FOLDER="."
INCLUDE_DB_DATA=false
INCLUDE_ALL=false
EXPLICIT_INCLUDES=()
EXPLICIT_EXCLUDES=()
EXCLUDE_CONTENT=()

# --- Parse Arguments ---
while [[ "$#" -gt 0 ]]; do
  case $1 in
    --data) INCLUDE_DB_DATA=true; shift ;;
    --include-all) INCLUDE_ALL=true; shift ;;
    --include) IFS=',' read -r -a EXPLICIT_INCLUDES <<< "$2"; shift 2 ;;
    --include=*) IFS=',' read -r -a EXPLICIT_INCLUDES <<< "${1#*=}"; shift 1 ;;
    --exclude) IFS=',' read -r -a EXPLICIT_EXCLUDES <<< "$2"; shift 2 ;;
    --exclude=*) IFS=',' read -r -a EXPLICIT_EXCLUDES <<< "${1#*=}"; shift 1 ;;
    --exclude-content) IFS=',' read -r -a EXCLUDE_CONTENT <<< "$2"; shift 2 ;;
    --exclude-content=*) IFS=',' read -r -a EXCLUDE_CONTENT <<< "${1#*=}"; shift 1 ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) TARGET_FOLDER="$1"; shift ;;
  esac
done

# Check if the target folder actually exists
if [ ! -d "$TARGET_FOLDER" ]; then
  echo "Error: Folder '$TARGET_FOLDER' does not exist." >&2
  exit 1
fi

FOLDER_NAME=$(basename "$(realpath "$TARGET_FOLDER")")
OUTPUT_FILE="${FOLDER_NAME}_report.xml"

# --- Dynamic Ignore Logic ---
TREE_IGNORES=()
FIND_EXCLUSIONS=()

should_ignore() {
    local target="$1"
    # Use :- to prevent unbound variable errors under set -u
    for inc in "${EXPLICIT_INCLUDES[@]:-}"; do
        if [[ "$inc" == "$target" ]]; then
            return 1 # False, do not ignore
        fi
    done
    return 0 # True, go ahead and ignore it
}

add_dir_ignore() {
    local name="$1"
    if should_ignore "$name"; then
        TREE_IGNORES+=("$name")
        FIND_EXCLUSIONS+=( -type d -name "$name" -prune -o )
    fi
}

add_file_ignore() {
    local name="$1"
    if should_ignore "$name"; then
        TREE_IGNORES+=("$name")
        FIND_EXCLUSIONS+=( -type f -name "$name" -prune -o )
    fi
}

# 1. Core Ignores 
add_dir_ignore ".git"
add_dir_ignore "__pycache__"
add_dir_ignore ".vs"
add_dir_ignore ".idea"
add_dir_ignore ".vscode"
add_file_ignore "*_report.xml"
add_file_ignore "*_report.txt"

# 2. Heavy Ignores 
if [ "$INCLUDE_ALL" = false ]; then
    add_dir_ignore "node_modules"
    add_dir_ignore "dist"
    add_dir_ignore "build"
    add_dir_ignore "out"
    add_dir_ignore "target"
    add_dir_ignore ".next"
    
    add_file_ignore "Cargo.lock"
    add_file_ignore "package-lock.json"
    add_file_ignore "pnpm-lock.yaml"
    add_file_ignore "go.sum"
    add_file_ignore ".env"
fi

# 3. Dynamic User Excludes
for exc in "${EXPLICIT_EXCLUDES[@]:-}"; do
    [[ -z "$exc" ]] && continue
    TREE_IGNORES+=("$exc")
    FIND_EXCLUSIONS+=( -name "$exc" -prune -o )
done

# 4. Dynamic Content-Only Excludes
for exc in "${EXCLUDE_CONTENT[@]:-}"; do
    [[ -z "$exc" ]] && continue
    FIND_EXCLUSIONS+=( -name "$exc" -prune -o )
done

# Close the find exclusions array
FIND_EXCLUSIONS+=( -type f -print0 )

IGNORE_TREE_PATTERNS=$(IFS="|"; echo "${TREE_IGNORES[*]:-}")

# --- Processing & Sanitization Functions ---

escape_xml() {
    # Replaces &, <, and > safely without disrupting file structures
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

process_source_file() {
    local file="$1"
    local ext="${file##*.}"
    ext="${ext,,}" # Convert to lowercase

    # Apply targeted comment stripping based on extension, then pipe to XML escaper
    case "$ext" in
        js|ts|jsx|tsx|java|c|cpp|cs|h|hpp)
            # Strips multi-line and single-line comments
            perl -0777 -pe 's/\/\*.*?\*\///gs; s/(?<!:)\/\/.*//g' "$file" | escape_xml
            ;;
        py|sh|rb|yaml|yml)
            # Strips full-line comments starting with hash
            perl -0777 -pe 's/^\s*#.*//gm' "$file" | escape_xml
            ;;
        html|xml|svg)
            # Strips standard markup comments
            perl -0777 -pe 's///gs' "$file" | escape_xml
            ;;
        *)
            # Fallback for untargeted files: Just escape the XML
            cat "$file" | escape_xml
            ;;
    esac
}

# --- Start Pipeline ---
echo "Generating XML codebase report for: $TARGET_FOLDER"

# Initialize XML Structure
echo "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" > "$OUTPUT_FILE"
echo "<repository target=\"$TARGET_FOLDER\">" >> "$OUTPUT_FILE"

# Step 1: Tree Structure
echo "<directory_structure>" >> "$OUTPUT_FILE"
if command -v tree >/dev/null 2>&1; then
    # || true prevents pipefail from crashing the script if tree returns non-zero
    tree -a "$TARGET_FOLDER" -I "$IGNORE_TREE_PATTERNS" | escape_xml >> "$OUTPUT_FILE" || true
else
    find "$TARGET_FOLDER" -type d | sed -e 's;[^/]*/;|____;g;s;____|; |;g' | escape_xml >> "$OUTPUT_FILE" || true
fi
echo "</directory_structure>" >> "$OUTPUT_FILE"

# Step 2: File Contents
echo "<files>" >> "$OUTPUT_FILE"

# Execute safely; || [[ -n "$file" ]] prevents premature exit on the last loop iteration
find "$TARGET_FOLDER" "${FIND_EXCLUSIONS[@]}" | sort -z | while IFS= read -r -d '' file || [[ -n "$file" ]]; do
  
  # Escape the file path attribute itself to ensure strict XML validity
  echo "<file path=\"$(echo "$file" | escape_xml)\">" >> "$OUTPUT_FILE"

  file_lower="${file,,}"

  if [[ "$file_lower" == *.pdf ]]; then
    if command -v pdftotext >/dev/null 2>&1; then
        # Bypasses the comment stripper, strictly pipes to XML escaper
        pdftotext "$file" - 2>/dev/null | escape_xml >> "$OUTPUT_FILE" || echo "[Could not extract text from PDF]" >> "$OUTPUT_FILE"
    else
        echo "[pdftotext not installed. Skipping PDF content]" >> "$OUTPUT_FILE"
    fi

  elif [[ "$file_lower" == *.db || "$file_lower" == *.sqlite || "$file_lower" == *.sqlite3 ]]; then
    if command -v sqlite3 >/dev/null 2>&1; then
      if [ "$INCLUDE_DB_DATA" = true ]; then
         sqlite3 "$file" .dump 2>/dev/null | escape_xml >> "$OUTPUT_FILE" || echo "[Error reading SQLite file]" >> "$OUTPUT_FILE"
      else
         sqlite3 "$file" .schema 2>/dev/null | escape_xml >> "$OUTPUT_FILE" || echo "[Error reading SQLite file]" >> "$OUTPUT_FILE"
      fi
    else
      echo "[Binary SQLite file detected. Install 'sqlite3' to see text dump]" >> "$OUTPUT_FILE"
    fi

  elif [[ "$file_lower" =~ \.(node|pyc|pkl|jpg|jpeg|png|gif|bmp|svg|webp|ico|mp4|mkv|avi|mov|wmv|flv|webm|ttf|otf|woff|woff2|eot|mp3|wav|zip|tar|gz|rar|exe|dll|so|obj|o|out|bin|pdb|class|tlog|ilk|idb|ipch|pch|gch|xlsx|xls|doc|docx|ppt|pptx|jar|csv|log)$ ]]; then
    echo "[Skipping known binary or build file based on extension]" >> "$OUTPUT_FILE"
    
  else
    # Fallback binary check
    MIME_ENCODING=$(file -b --mime-encoding "$file" 2>/dev/null || echo "binary")
    if [[ "$MIME_ENCODING" == "binary" ]]; then
        echo "[Skipping binary file detected by mime-encoding check]" >> "$OUTPUT_FILE"
    else
        # Correctly redirected output to append securely into the XML file
        process_source_file "$file" >> "$OUTPUT_FILE" 2>/dev/null || echo "[Content unreadable or permissions denied]" >> "$OUTPUT_FILE"
    fi
  fi

  echo "</file>" >> "$OUTPUT_FILE"
done

echo "</files>" >> "$OUTPUT_FILE"
echo "</repository>" >> "$OUTPUT_FILE"

echo "Done! Saved token-optimized report to $OUTPUT_FILE"
